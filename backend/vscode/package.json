{
  "name": "adam-vscode",
  "displayName": "Adam — IA de programação",
  "description": "O Adam lê e entende seu projeto inteiro, implementa funcionalidades, corrige bugs, refaz design, roda comandos, consulta o banco e desfaz alterações, direto no VS Code.",
  "version": "2.0.0",
  "publisher": "felipehudson",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "adam",
          "title": "Adam",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "adam": [
        {
          "type": "webview",
          "id": "adam.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "adam.newChat",
        "title": "Adam: Nova conversa"
      },
      {
        "command": "adam.undo",
        "title": "Adam: Desfazer alterações da última tarefa"
      },
      {
        "command": "adam.askSelection",
        "title": "Adam: Explicar / revisar a seleção"
      },
      {
        "command": "adam.fixProblems",
        "title": "Adam: Corrigir erros do arquivo aberto"
      },
      {
        "command": "adam.setApiKey",
        "title": "Adam: Configurar chave de API"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "adam.askSelection",
          "when": "editorHasSelection",
          "group": "navigation@50"
        },
        {
          "command": "adam.fixProblems",
          "group": "navigation@51"
        }
      ]
    },
    "configuration": {
      "title": "Adam",
      "properties": {
        "adam.server": {
          "type": "string",
          "default": "",
          "description": "Endereço do servidor do Adam."
        },
        "adam.engine": {
          "type": "string",
          "enum": [
            "auto",
            "pro",
            "local"
          ],
          "enumDescriptions": [
            "Adam Pro, com Ollama local de reserva",
            "Somente Adam Pro (servidor)",
            "Somente Ollama local"
          ],
          "default": "auto",
          "description": "Qual cérebro o Adam usa."
        },
        "adam.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "URL do seu Ollama."
        },
        "adam.ollamaModel": {
          "type": "string",
          "default": "qwen2.5",
          "description": "Modelo do Ollama (precisa suportar ferramentas, ex: qwen2.5)."
        },
        "adam.autonomia": {
          "type": "string",
          "enum": [
            "perguntar",
            "edicoes",
            "total"
          ],
          "enumDescriptions": [
            "Pede aprovação para cada edição, comando, leitura do .env e consulta ao banco",
            "Aplica edições sozinho (dá para desfazer); pede aprovação para comandos, .env e banco",
            "Autônomo total: faz tudo sem perguntar"
          ],
          "default": "perguntar",
          "description": "Quanto o Adam pode fazer sem pedir aprovação."
        }
      }
    }
  }
}